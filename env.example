# =============================================================================
# CAPTCHA Factory - Variables d'environnement
# =============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GÉNÉRAL
# -----------------------------------------------------------------------------

# Environnement (development, production, test)
ENVIRONMENT=development

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DEVICE (PyTorch)
# -----------------------------------------------------------------------------

# Device pour l'inférence des modèles
# Options: cpu, cuda, cuda:0, cuda:1, mps (Apple Silicon)
DEVICE=cpu

# -----------------------------------------------------------------------------
# MODÈLES
# -----------------------------------------------------------------------------

# Modèle par défaut pour la résolution
# Options: crnn, trocr, florence, easyocr, cascade
DEFAULT_MODEL=trocr

# Seuil de confiance pour le mode cascade (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.85

# Répertoire de cache pour les modèles HuggingFace
# Par défaut: ./models/cache
HF_CACHE_DIR=./models/cache

# Modèles à précharger au démarrage (séparés par des virgules)
# Laisser vide pour charger à la demande
PRELOAD_MODELS=trocr

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Host et port de l'API FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Origines autorisées (séparées par des virgules, * pour tout)
CORS_ORIGINS=*

# Taille maximale des uploads (en bytes)
MAX_UPLOAD_SIZE=10485760

# Rate limiting (requêtes par minute)
RATE_LIMIT=100

# -----------------------------------------------------------------------------
# DASHBOARD
# -----------------------------------------------------------------------------

# Port du dashboard Streamlit
DASHBOARD_PORT=8501

# -----------------------------------------------------------------------------
# GÉNÉRATEUR
# -----------------------------------------------------------------------------

# Charset par défaut pour la génération
# Options: crnn (19 chars), digits, lowercase, uppercase, alphanumeric
DEFAULT_CHARSET=crnn

# Paramètres par défaut
DEFAULT_CAPTCHA_LENGTH=5
DEFAULT_CAPTCHA_WIDTH=200
DEFAULT_CAPTCHA_HEIGHT=60
DEFAULT_NOISE_LEVEL=0.3

# -----------------------------------------------------------------------------
# WEBSCRAPING (Playwright)
# -----------------------------------------------------------------------------

# Timeout pour les requêtes web (en millisecondes)
SCRAPER_TIMEOUT=30000

# User agent par défaut
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Mode headless (true pour serveur, false pour debug)
SCRAPER_HEADLESS=true

# -----------------------------------------------------------------------------
# HUGGINGFACE (Optionnel)
# -----------------------------------------------------------------------------

# Token HuggingFace pour les modèles privés
# Obtenez-le sur: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# DÉVELOPPEMENT
# -----------------------------------------------------------------------------

# Mode debug (active les logs détaillés)
DEBUG=false

# Rechargement automatique (pour uvicorn)
RELOAD=true
